# =====================================================================
# The Premiere · Konfigurasi Apache untuk hosting cPanel
# File ini ikut tersalin ke folder dist/ saat `npm run build`.
# Upload SELURUH isi dist/ (termasuk file tersembunyi .htaccess) ke public_html.
# =====================================================================

Options -Indexes

<IfModule mod_headers.c>
  # Batasi sumber yang boleh dimuat halaman (mencegah XSS memuat script dari luar).
  # img/media mengizinkan https: karena foto, video & musik bisa berupa link dari admin.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # Cegah undangan/admin ditampilkan di dalam iframe situs lain (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Kamera hanya untuk scanner check-in di situs ini sendiri.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"

  # Aset di folder assets/ punya hash di nama file: aman di-cache lama.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # index.html selalu dicek ulang agar versi baru langsung terpakai setelah upload.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Jangan sajikan file sensitif jika tidak sengaja ikut ter-upload.
<FilesMatch "^\.(env|git)|\.(sql|md|map|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
