# Salin menjadi `.env` lalu isi. Nilainya ikut tertanam saat `npm run build` (hosting cPanel).
# Panduan lengkap: docs/SETUP-CLIENT-BARU.md

# Supabase (Project Settings → API). Kosongkan keduanya untuk mode demo lokal.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Domain undangan (tanpa garis miring di akhir), untuk og:url / preview link.
VITE_SITE_URL=""

# PIN admin khusus mode demo lokal (tanpa Supabase). Default: 2027
VITE_ADMIN_PIN=""
